# AIOps Agent — Environment Variables
# Copy to .env and fill in your values.

# Telegram Bot (required if telegram.enabled: true in config.yaml)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234gh

# LLM API Keys (for Phase 2+)
OPENAI_API_KEY=sk-...
#   atau pakai variabel khusus AIOps (prioritas lebih tinggi):
# AIOPS_LLM_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# LLM Configuration Overrides (opsional — override config.yaml via .env)
#   Provider: openai | anthropic | deepseek
AIOPS_LLM_PROVIDER=openai
#   Model name
# AIOPS_LLM_MODEL=gpt-4o
#   Custom endpoint (misal: 9router, local LLM, OpenAI-compatible proxy)
AIOPS_LLM_BASE_URL=https://9router-host-kamu/v1
#   Temperature (0.0 - 2.0)
# AIOPS_LLM_TEMPERATURE=0.3
#   Max tokens
# AIOPS_LLM_MAX_TOKENS=2048

# Logging
LOG_LEVEL=info

# Config
CONFIG_PATH=config.yaml
DATA_DIR=./data

# Phase override (1 = read-only, 2 = write-enabled)
AIOPS_PHASE=1
