# AIOps Agent — Environment Variables
# Copy to .env and fill in your values.

# Telegram Bot (required if telegram.enabled: true in config.yaml)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234gh

# LLM API Keys (for Phase 2+)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Logging
LOG_LEVEL=info

# Config
CONFIG_PATH=config.yaml
DATA_DIR=./data

# Phase override (1 = read-only, 2 = write-enabled)
AIOPS_PHASE=1